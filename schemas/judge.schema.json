{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MultiCat Judge Output",
  "type": "object",
  "required": ["status", "issues"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": ["string", "null"]
    }
  }
}
